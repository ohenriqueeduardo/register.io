# ==============================================================================
# REGISTER.IO - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL / Supabase / Neon / Local)
# ------------------------------------------------------------------------------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/register_io?schema=public"

# ------------------------------------------------------------------------------
# 2. SEGURANÇA & SESSÃO (JWT)
# ------------------------------------------------------------------------------
# Chave secreta de alta entropia para assinatura dos cookies JWT (mínimo 32 caracteres)
# Exemplo para gerar no terminal: openssl rand -base64 32
JWT_SECRET="seu-segredo-jwt-ultra-seguro-com-mais-de-32-caracteres"

# Permite registro público de novos usuários via /cadastro em ambiente de produção
# Se "false", apenas administradores podem criar novos usuários
ALLOW_PUBLIC_REGISTRATION="true"

# ------------------------------------------------------------------------------
# 3. STORAGE DE ARQUIVOS (Supabase Storage)
# ------------------------------------------------------------------------------
# Usado para uploads de catálogos de produtos e anexos PDF das empresas
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-do-supabase"
SUPABASE_BUCKET="catalogos"

# ------------------------------------------------------------------------------
# 4. CRON JOBS & HEALTHCHECK
# ------------------------------------------------------------------------------
# Segredo enviado no header Authorization: Bearer <CRON_SECRET> para disparar /api/cron/keep-alive
CRON_SECRET="segredo-para-execucao-de-cron-jobs"

# ------------------------------------------------------------------------------
# 5. LOGGING
# ------------------------------------------------------------------------------
# Nível de log: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 6. SEED INICIAL (prisma/seed.ts)
# ------------------------------------------------------------------------------
# Credenciais configuradas automaticamente ao rodar `pnpm prisma:seed`
MASTER_ADMIN_NAME="Master Admin"
MASTER_ADMIN_EMAIL="admin@savezone.local"
MASTER_ADMIN_PASSWORD="Master@SaveZone2026!Secure"

ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@sistema.com"
ADMIN_PASSWORD="SenhaTemporaria123!"
